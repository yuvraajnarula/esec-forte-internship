<div class="modal-div hidden">
  <div class="modal">
    <div class="modal-header">
      <h3>
        Information
      </h3>
      <img src="close-button.svg" width="20" height="20" class="close-btn">
    </div>
    <div class="modal-content">
      <p>
        These are the 30 issues that we take into account in this format. Here is a file in <a href="/file/download/template_vulnerabilities.xlsx">downloadable format.</a>
      </p>
      <button class="dropdown">
        List of Issues
      </button>
      <div class="dropdown-content">
        <% vulnerabilities.forEach(vulnerability=>{ %>
          <span>
            <%= vulnerability %>
          </span><br>
        <% }) %>
      </div>
    </div>
  </div>
</div>
<div class="upload-container">
  <button
    class="info-btn"
  >
    i
  </button>
  <h1>Submit your report here</h1>
  <form action="/file/submit" method="POST" enctype="multipart/form-data">
    <label for="report-file" class="file-label">Upload audit report</label>
    <input type="file" id="report-file" name="file" accept=".xlsx,.ods" required />
    <div class="file-name" id="file-name">No file chosen</div>
    <label for="reference-zip" class="file-label">Upload image reference zip</label>
    <input type="file" id="reference-zip" name="referenceZip" accept=".zip,.rar" required />
    <div class="file-name" id="zip-file-name">No file chosen</div>
    <button class="button" type="submit">Submit</button>
  </form>
</div>
<script>
  // Report file logic
  const fileInput = document.getElementById('report-file');
  const fileNameDiv = document.getElementById('file-name');

  fileInput.addEventListener('change', () => {
    const name = fileInput.files.length ? fileInput.files[0].name : 'No file chosen';
    updateFileNameDisplay(fileNameDiv, name, fileInput.files.length);
  });

  // Zip file logic
  const zipInput = document.getElementById('reference-zip');
  const zipFileNameDiv = document.getElementById('zip-file-name');

  zipInput.addEventListener('change', () => {
    const name = zipInput.files.length ? zipInput.files[0].name : 'No file chosen';
    updateFileNameDisplay(zipFileNameDiv, name, zipInput.files.length);
  });

  // Shared style logic
  function updateFileNameDisplay(element, name, hasFile) {
    element.textContent = name;
    element.style.visibility = hasFile ? 'visible' : 'hidden';
    element.style.fontSize = hasFile ? '0.9em' : '0';
    element.style.minHeight = hasFile ? '1.2em' : '0';
    element.style.transition = 'font-size 0.2s, min-height 0.2s, visibility 0.2s';
    element.style.marginBottom = hasFile ? '1.2em' : '0';
    element.style.padding = hasFile ? '10px' : '0';
    element.style.border = hasFile ? '1px solid #999' : '0';
    element.style.borderRadius = hasFile ? '4px' : '0';
    element.style.background = hasFile ? 'linear-gradient(to top, #f9f9f9, #e3e3e3)' : 'none';
  }

  // Modal logic
  document.querySelector('.close-btn').addEventListener('click', () => {
    document.querySelector('.modal-div').classList.add('hidden');
  });

  document.querySelector('.info-btn').addEventListener('click', () => {
    document.querySelector('.modal-div').classList.remove('hidden');
  });
</script>

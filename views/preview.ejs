<style>
/* Container and Spacing */
.container {
  max-width: 1200px; /* Increased from 960px */
  margin: 0 auto;
  padding: 0 1rem;
}

.my-5 {
  margin-top: 3rem !important;
  margin-bottom: 3rem !important;
}

.mb-4 {
  margin-bottom: 1.5rem !important;
}

.mb-3 {
  margin-bottom: 1rem !important;
}

.mr-2 {
  margin-right: 0.5rem !important;
}

.d-flex {
  display: flex !important;
}

.flex-wrap {
  flex-wrap: wrap !important;
}

.align-items-center {
  align-items: center !important;
}

.gap-2 {
  gap: 0.5rem;
}

/* Headings */
h1 {
  font-size: 2rem;
  font-weight: 600;
  color: #333;
  margin-bottom: 0.75rem;
}

/* Buttons */
.btn {
  display: inline-block;
  font-size: 1rem;
  font-weight: 500;
  text-align: center;
  text-decoration: none;
  padding: 0.5rem 1rem;
  border-radius: 0.375rem;
  transition: background-color 0.2s ease, color 0.2s ease;
  cursor: pointer;
  border: 1px solid transparent;
}

.btn-sm {
  padding: 0.25rem 0.5rem;
  font-size: 0.875rem;
}

.btn-primary {
  background-color: #007bff;
  color: #fff;
  border: 1px solid #007bff;
}

.btn-primary:hover {
  background-color: #0056b3;
  border-color: #0056b3;
  color: #fff;
}

.btn-outline-secondary {
  background-color: transparent;
  color: #6c757d;
  border: 1px solid #6c757d;
}

.btn-outline-secondary:hover {
  background-color: #6c757d;
  color: #fff;
}

.btn-outline-info {
  background-color: transparent;
  color: #17a2b8;
  border: 1px solid #17a2b8;
}

.btn-outline-info:hover {
  background-color: #17a2b8;
  color: #fff;
}

/* Table */
.table-responsive {
  width: 100%;
  overflow-x: auto;
  margin-bottom: 1.5rem;
}

.table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 1.5rem;
  font-size: 0.9rem; /* Slightly smaller font */
  min-width: 1000px; /* Ensure minimum width */
}

.table th,
.table td {
  padding: 0.75rem 0.5rem; /* Reduced horizontal padding */
  border: 1px solid #dee2e6;
  vertical-align: top;
  text-align: left;
  word-wrap: break-word;
  overflow-wrap: break-word;
}

/* Specific column widths */
.table th:nth-child(1),
.table td:nth-child(1) {
  width: 50px; /* Index column */
  text-align: center;
}

.table th:nth-child(2),
.table td:nth-child(2) {
  width: 80px; /* vul_id */
  text-align: center;
}

.table th:nth-child(3),
.table td:nth-child(3) {
  width: 80px; /* app_id */
  text-align: center;
}

.table th:nth-child(4),
.table td:nth-child(4) {
  width: 150px; /* vul_title */
}

.table th:nth-child(5),
.table td:nth-child(5) {
  width: 200px; /* affected_url */
  word-break: break-all;
}

.table th:nth-child(6),
.table td:nth-child(6) {
  width: 100px; /* risk_rating */
  text-align: center;
}

.table th:nth-child(7),
.table td:nth-child(7) {
  width: 150px; /* affected_parameters */
}

.table th:nth-child(8),
.table td:nth-child(8) {
  min-width: 200px; /* description */
}

.table-striped tbody tr:nth-child(odd) {
  background-color: #f9f9f9;
}

.table-bordered th,
.table-bordered td {
  border: 1px solid #dee2e6;
}

.thead-light th {
  background-color: #f1f1f1;
  font-weight: 600;
  cursor: pointer;
  position: relative;
  user-select: none;
  white-space: nowrap;
}

.thead-light th:hover {
  background-color: #e2e6ea;
}

.sort-icon {
  margin-left: 5px;
  opacity: 0.5;
}

.sort-icon.active {
  opacity: 1;
}

/* Alerts */
.alert {
  padding: 0.75rem 1rem;
  border-radius: 0.25rem;
  margin-bottom: 1.5rem;
}

.alert-warning {
  background-color: #fff3cd;
  color: #856404;
  border: 1px solid #ffeeba;
}

.alert-info {
  background-color: #d1ecf1;
  color: #0c5460;
  border: 1px solid #bee5eb;
}

/* File-download link */
.file-label {
  color: #007bff;
  text-decoration: none;
  font-weight: 500;
}

.file-label:hover {
  text-decoration: underline;
}

/* Form controls */
.form-control {
  display: block;
  width: 100%;
  font-size: 1rem;
  padding: 0.5rem 0.75rem;
  line-height: 1.5;
  color: #495057;
  background-color: #fff;
  border: 1px solid #ced4da;
  border-radius: 0.375rem;
}

.form-select {
  display: block;
  width: 100%;
  font-size: 1rem;
  padding: 0.5rem 0.75rem;
  line-height: 1.5;
  color: #495057;
  background-color: #fff;
  border: 1px solid #ced4da;
  border-radius: 0.375rem;
  cursor: pointer;
}

/* Filter section */
.filter-section {
  background-color: #f8f9fa;
  padding: 1rem;
  border-radius: 0.5rem;
  margin-bottom: 1.5rem;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  align-items: end;
}

.filter-group {
  display: flex;
  flex-direction: column;
  min-width: 200px;
  margin-left: 0.5vw;
  margin-right: 5vw;
}

.filter-group label {
  font-weight: 500;
  margin-bottom: 0.25rem;
  color: #495057;
}

/* Stats */
.stats-row {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-bottom: 1rem;
}

.stat-item {
  background-color: #e9ecef;
  padding: 0.5rem 1rem;
  border-radius: 0.25rem;
  font-weight: 500;
}

/* Highlight */
.highlight {
  background-color: yellow;
  padding: 1px 2px;
}

/* URL styling */
.table td a {
  color: #007bff;
  text-decoration: none;
  word-break: break-all;
}

.table td a:hover {
  text-decoration: underline;
}

/* Risk rating styling */
.table td:nth-child(6) {
  font-weight: 500;
}

.table td:nth-child(6):contains("High") {
  color: #dc3545;
}

.table td:nth-child(6):contains("Medium") {
  color: #fd7e14;
}

.table td:nth-child(6):contains("Low") {
  color: #28a745;
}

/* Responsive */
@media (max-width: 768px) {
  .container {
    max-width: 100%;
    padding: 0 0.5rem;
  }
  
  .filter-row {
    flex-direction: column;
  }
  
  .filter-group {
    min-width: 100%;
  }
  
  .stats-row {
    flex-direction: column;
  }
  
  .table {
    font-size: 0.8rem;
    min-width: 800px;
  }
  
  .table th,
  .table td {
    padding: 0.5rem 0.25rem;
  }
}
</style>

<div class="container my-5">
  <h1 class="mb-4">Preview Your Report</h1>

  <div class="stats-row">
    <div class="stat-item">
      <strong>Total rows parsed:</strong> <span id="totalRowsCount"><%= totalRows?.length || 0 %></span>
    </div>
    <div class="stat-item">
      <strong>Showing:</strong> <span id="visibleRowsCount"><%= rows?.length || 0 %></span> rows
    </div>
    <div class="stat-item">
      <strong>With images:</strong> <span id="withImagesCount">0</span>
    </div>
  </div>

  <p class="mb-4">
    <a href="/file/download/<%= downloadName %>" class="btn btn-primary" aria-label="Download full report">
      <i class="fas fa-file-download"></i> Download the full report
    </a>
  </p>

  <% if (rows && rows.length) { %>

  <!-- Enhanced Filter Section -->
  <div class="filter-section">
    <div class="filter-row">
      <!-- Search Input -->
      <div class="filter-group">
        <label for="tableSearch">Search Issues</label>
        <input
          type="text"
          id="tableSearch"
          placeholder="🔍 Search in all columns..."
          class="form-control"
        />
      </div>

      <!-- Column Filter -->
      <div class="filter-group">
        <label for="columnFilter">Search in Column</label>
        <select id="columnFilter" class="form-select">
          <option value="all">All Columns</option>
          <% colHeaders.forEach(col => { %>
          <option value="<%= col %>"><%= col %></option>
          <% }) %>
        </select>
      </div>

      <!-- Image Filter -->
      <div class="filter-group">
        <label for="imageFilter">Image Status</label>
        <select id="imageFilter" class="form-select">
          <option value="all">All Items</option>
          <option value="with">With Images</option>
          <option value="without">Without Images</option>
        </select>
      </div>

      <!-- Action Buttons -->
      <div class="filter-group">
        <div class="d-flex gap-2">
          <button id="clearFilters" class="btn btn-outline-secondary btn-sm">Clear All</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Results Info -->
  <div id="resultsInfo" class="alert alert-info" style="display: none;"></div>

  <div class="table-responsive">
    <table class="table table-striped table-bordered">
      <thead class="thead-light">
        <tr>
          <th data-sort="index"># <span class="sort-icon">↕</span></th>
          <% colHeaders.forEach(col => { %>
          <th data-sort="<%= col %>"><%= col %> <span class="sort-icon">↕</span></th>
          <% }) %>
        </tr>
      </thead>
      <tbody id="dataTable">
        <% rows.forEach((row, index) => { %>
        <tr data-index="<%= index %>">
          <td><%= index + 1 %></td>
          <% Object.keys(row).forEach(col => { %>
          <td data-column="<%= col %>">
            <% if (col === "img_ref_address") { %>
              <% if (row[col] === '') { %>
                <span class="text-muted">No Image Available</span>
              <% } else { %>
                <a href="/file/image/preview/<%= row[col] %>" target="_blank"><%= row[col] %></a>
              <% } %>
            <% } else { %>
              <%= row[col] %>
            <% } %>
          </td>
          <% }) %>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% } else { %>
    <div class="alert alert-warning">No rows to preview.</div>
  <% } %>
</div>

<script>
  let allRows = [];
  let currentSort = { column: null, direction: 'asc' };

  // Initialize
  document.addEventListener('DOMContentLoaded', function() {
    // Store all rows data
    const tableRows = document.querySelectorAll('#dataTable tr');
    allRows = Array.from(tableRows).map(row => {
      const cells = row.querySelectorAll('td');
      const data = {};
      cells.forEach((cell, index) => {
        if (index === 0) {
          data.index = parseInt(cell.textContent);
          data.originalIndex = row.dataset.index;
        } else {
          const column = cell.dataset.column;
          data[column] = cell.textContent.trim();
        }
      });
      data.element = row;
      return data;
    });

    updateStats();
    setupEventListeners();
  });

  function setupEventListeners() {
    // Search functionality
    document.getElementById('tableSearch').addEventListener('input', filterTable);
    document.getElementById('columnFilter').addEventListener('change', filterTable);
    document.getElementById('imageFilter').addEventListener('change', filterTable);

    // Clear filters
    document.getElementById('clearFilters').addEventListener('click', clearAllFilters);

    // Sorting
    document.querySelectorAll('th[data-sort]').forEach(th => {
      th.addEventListener('click', () => sortTable(th.dataset.sort));
    });
  }

  function filterTable() {
    const searchTerm = document.getElementById('tableSearch').value.toLowerCase().trim();
    const columnFilter = document.getElementById('columnFilter').value;
    const imageFilter = document.getElementById('imageFilter').value;

    let visibleCount = 0;
    let withImagesCount = 0;

    allRows.forEach(rowData => {
      let shouldShow = true;

      // Text search filter
      if (searchTerm) {
        if (columnFilter === 'all') {
          // Search in all columns
          const allText = Object.values(rowData)
            .filter(value => typeof value === 'string') // Ensure only strings are searched
            .join(' ')
            .toLowerCase();
          shouldShow = allText.includes(searchTerm);
        } else {
          // Search in specific column
          const columnText = (rowData[columnFilter] || '').toLowerCase();
          shouldShow = columnText.includes(searchTerm);
        }
      }

      // Image filter
      if (shouldShow && imageFilter !== 'all') {
        const hasImage = rowData.img_ref_address &&
                         rowData.img_ref_address.trim() !== '' &&
                         rowData.img_ref_address.trim().toLowerCase() !== 'no image available';

        if (imageFilter === 'with' && !hasImage) shouldShow = false;
        if (imageFilter === 'without' && hasImage) shouldShow = false;
      }

      // Show/hide row
      rowData.element.style.display = shouldShow ? '' : 'none';

      if (shouldShow) {
        visibleCount++;
        // Count images for visible rows
        const hasImage = rowData.img_ref_address &&
                         rowData.img_ref_address.trim() !== '' &&
                         rowData.img_ref_address.trim().toLowerCase() !== 'no image available';
        if (hasImage) withImagesCount++;

        // Highlight search terms
        highlightSearchTerms(rowData.element, searchTerm, columnFilter);
      }
    });

    updateVisibleStats(visibleCount, withImagesCount);
    showResultsInfo(searchTerm, columnFilter, imageFilter, visibleCount);
  }

  function highlightSearchTerms(row, searchTerm, columnFilter) {
    if (!searchTerm) return;

    const cells = row.querySelectorAll('td');
    cells.forEach((cell, index) => {
      if (index === 0) return; // Skip index column

      // Remove existing highlights
      cell.innerHTML = cell.innerHTML.replace(/<mark class="highlight">([^<]*)<\/mark>/gi, '$1');

      if (columnFilter === 'all' || cell.dataset.column === columnFilter) {
        const regex = new RegExp(`(${searchTerm})`, 'gi');
        cell.innerHTML = cell.innerHTML.replace(regex, '<mark class="highlight">$1</mark>');
      }
    });
  }

  function sortTable(column) {
    // Update sort direction
    if (currentSort.column === column) {
      currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
    } else {
      currentSort.column = column;
      currentSort.direction = 'asc';
    }

    // Update sort icons
    document.querySelectorAll('.sort-icon').forEach(icon => {
      icon.classList.remove('active');
      icon.textContent = '↕';
    });

    const activeHeader = document.querySelector(`th[data-sort="${column}"] .sort-icon`);
    activeHeader.classList.add('active');
    activeHeader.textContent = currentSort.direction === 'asc' ? '↑' : '↓';

    // Sort data
    const visibleRows = allRows.filter(row => row.element.style.display !== 'none');
    visibleRows.sort((a, b) => {
      let aVal = column === 'index' ? a.index : (a[column] || '');
      let bVal = column === 'index' ? b.index : (b[column] || '');

      // Handle numeric values
      if (column === 'index' || (!isNaN(aVal) && !isNaN(bVal))) {
        aVal = parseFloat(aVal) || 0;
        bVal = parseFloat(bVal) || 0;
      } else {
        aVal = aVal.toString().toLowerCase();
        bVal = bVal.toString().toLowerCase();
      }

      if (currentSort.direction === 'asc') {
        return aVal > bVal ? 1 : aVal < bVal ? -1 : 0;
      } else {
        return aVal < bVal ? 1 : aVal > bVal ? -1 : 0;
      }
    });

    // Reorder DOM elements
    const tbody = document.getElementById('dataTable');
    visibleRows.forEach(row => tbody.appendChild(row.element));
  }

  function clearAllFilters() {
    document.getElementById('tableSearch').value = '';
    document.getElementById('columnFilter').value = 'all';
    document.getElementById('imageFilter').value = 'all';
    
    allRows.forEach(rowData => {
      rowData.element.style.display = '';
      // Remove highlights
      const cells = rowData.element.querySelectorAll('td');
      cells.forEach(cell => {
        cell.innerHTML = cell.innerHTML.replace(/<mark class="highlight">([^<]*)<\/mark>/gi, '$1');
      });
    });

    updateStats();
    document.getElementById('resultsInfo').style.display = 'none';
  }
  function updateStats() {
    const totalRows = allRows.length;
    const withImages = allRows.filter(row => {
      const hasImage = row.img_ref_address && 
                      row.img_ref_address.trim() !== '' && 
                      row.img_ref_address.trim().toLowerCase() !== 'no image available';
      return hasImage;
    }).length;

    document.getElementById('totalRowsCount').textContent = totalRows;
    document.getElementById('withImagesCount').textContent = withImages;
  }

  function updateVisibleStats(visibleCount, withImagesCount) {
    document.getElementById('visibleRowsCount').textContent = visibleCount;
    document.getElementById('withImagesCount').textContent = withImagesCount;
  }

  function showResultsInfo(searchTerm, columnFilter, imageFilter, visibleCount) {
    const resultsInfo = document.getElementById('resultsInfo');
    
    if (searchTerm || columnFilter !== 'all' || imageFilter !== 'all') {
      let message = `Showing ${visibleCount} filtered results`;
      
      if (searchTerm) {
        message += ` for "${searchTerm}"`;
        if (columnFilter !== 'all') {
          message += ` in ${columnFilter}`;
        }
      }
      
      if (imageFilter !== 'all') {
        message += ` (${imageFilter} images)`;
      }
      
      resultsInfo.textContent = message;
      resultsInfo.style.display = 'block';
    } else {
      resultsInfo.style.display = 'none';
    }
  }
</script>